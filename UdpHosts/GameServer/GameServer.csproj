<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- FauFau's StaticDB derives from Bitter's BinaryWrapper, so the Bitter
         assembly must load at runtime. Bundle managed dependencies into
         RID-specific publishes so GameServer.exe cannot be separated from
         Bitter.dll by extraction or release packaging. Local,
         framework-independent builds remain unchanged. -->
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(RuntimeIdentifier)' != ''">true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aero.Gen" Version="1.5.0"/>
    <PackageReference Include="Autofac" Version="9.1.0" />
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="Google.Protobuf" Version="3.34.1" />
    <PackageReference Include="Grpc.Net.Client" Version="2.76.0" />
    <PackageReference Include="Grpc.Tools" Version="2.76.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog.Enrichers.Context" Version="4.6.5" />
    <PackageReference Include="Serilog.Settings.AppSettings" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.Map" Version="2.0.0" />
    <PackageReference Include="Serilog.Sinks.Seq" Version="9.0.0" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.5" />
    <PackageReference Include="FauFau" Version="1.5.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Lib\AeroMessages\AeroMessages\AeroMessages.csproj" />
    <ProjectReference Include="..\..\Lib\BepuPhysics2\BepuPhysics\BepuPhysics.csproj" />
    <!-- FauFau's StaticDB derives from Bitter's BinaryWrapper and calls it while
         parsing clientdb.sd2. The FauFau NuGet package does not carry a Bitter
         dependency, so reference the submodule project directly and keep its
         assembly in both the build output and the published runtime dependency
         closure. Do not mark this reference PrivateAssets. -->
    <ProjectReference Include="..\..\Lib\Bitter\Bitter\Bitter.csproj">
      <Private>true</Private>
    </ProjectReference>
    <ProjectReference Include="..\..\Lib\Core.Data\Core.Data.csproj" />
    <ProjectReference Include="..\..\Lib\Shared.Common\Shared.Common.csproj" />
    <ProjectReference Include="..\..\Lib\Shared.Udp\Shared.Udp.csproj" />
    <ProjectReference Include="..\..\Lib\Shared.Debug\Shared.Debug.csproj" />
    <ProjectReference Include="..\..\Lib\Shared.Collision\Shared.Collision.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ContentWithTargetPath Include="StaticDB\CustomData\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>StaticDB\CustomData\%(RecursiveDir)\%(Filename)%(Extension)</TargetPath>
    </ContentWithTargetPath>

    <None Include="GameServer.config.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="GRPC\GameServerAPI.proto" GrpcServices="Client" />
  </ItemGroup>
  <Target Name="Create_App-config_from_App-Default-config" Condition="!Exists('App.config')" BeforeTargets="Build">
    <Copy SourceFiles="App.Default.config" DestinationFiles="App.config" />
  </Target>
  <Target Name="FallbackGameServerConfigToOutput" AfterTargets="CopyFilesToOutputDirectory;Publish">
    <Copy SourceFiles="GameServer.config.example.json"
          DestinationFiles="$(OutDir)GameServer.config.json"
          Condition="!Exists('$(OutDir)GameServer.config.json')" />
    <Copy SourceFiles="GameServer.config.example.json"
          DestinationFiles="$(PublishDir)GameServer.config.json"
          Condition="'$(PublishDir)' != '' and !Exists('$(PublishDir)GameServer.config.json')" />
  </Target>
</Project>